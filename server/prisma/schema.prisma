// Author: Preston Lee

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamMemberRole {
  ADMIN
  MEMBER
}

enum WorkspaceVisibility {
  PRIVATE
  PUBLIC
}

enum WorkspacePrincipalType {
  USER
  TEAM
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum EndpointRole {
  EVALUATION
  DATA
  TERMINOLOGY
  CONTENT
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ssoIssuer   String
  ssoSubject  String
  email       String?
  displayName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  experimental               Boolean @default(false)
  developer                  Boolean @default(false)
  themePreferred             String  @default("automatic")
  validateSchema             Boolean @default(false)
  runnerApiBaseUrl           String  @default("")
  runnerFhirBaseUrl          String  @default("")
  defaultTestResultsIndexUrl String  @default("")
  fhirPackageRegistryBaseUrl String  @default("")
  vsacFhirBaseUrl            String  @default("")
  vsacApiUsername            String  @default("")
  vsacApiPassword            String  @default("")
  aiProvider                 String  @default("ollama")
  ollamaBaseUrl              String  @default("")
  ollamaModel                String  @default("")
  openaiModel                String  @default("")
  compatibleProviderName     String  @default("")
  compatibleProviderBaseUrl  String  @default("")
  compatibleProviderModel    String  @default("")
  searxngBaseUrl             String  @default("")
  enableAiAssistant          Boolean @default(true)
  useMCPTools                Boolean @default(false)
  allowAiWriteOperations     Boolean @default(false)
  autoApplyCodeEdits         Boolean @default(true)
  requireDiffPreview         Boolean @default(false)
  planActSeparateModels      Boolean @default(false)
  enableAiCodePrediction     Boolean @default(true)

  sessions              Session[]
  teamMemberships       TeamMembership[]
  createdTeams          Team[]                 @relation("TeamCreatedBy")
  createdWorkspaces     Workspace[]            @relation("WorkspaceCreatedBy")
  grantedAccess         WorkspaceAccessGrant[] @relation("GrantGrantedBy")
  workspaceActivity     WorkspaceActivity[]
  createdResourceRefs   WorkspaceResourceReference[]
  environments          UserEnvironment[]
  openCodeSessions      OpenCodeSession[]

  @@unique([ssoIssuer, ssoSubject])
  @@index([email])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([lastLoginAt])
}

model OpenCodeSession {
  id                String   @id @db.Uuid
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  openCodeSessionId String
  title             String
  status            String
  activeLibraryId   String
  activeFile        String
  model             String
  reasoningEnabled  Boolean  @default(false)
  runnerCreatedAt   DateTime
  lastActivityAt    DateTime
  expiresAt         DateTime
  workspaceOrigin   Json?
  state             Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, activeLibraryId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model Team {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String   @unique
  createdByUserId String   @db.Uuid
  createdBy       User     @relation("TeamCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships TeamMembership[]

  @@index([createdByUserId])
  @@index([createdAt])
  @@index([updatedAt])
}

model TeamMembership {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String         @db.Uuid
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model Workspace {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String              @unique
  visibility      WorkspaceVisibility @default(PRIVATE)
  description     String?
  createdByUserId String              @db.Uuid
  createdBy       User                @relation("WorkspaceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  grants             WorkspaceAccessGrant[]
  activity           WorkspaceActivity[]
  sharedEnvironments SharedEnvironment[]
  resourceReferences WorkspaceResourceReference[]

  @@index([createdByUserId])
  @@index([visibility])
  @@index([createdAt])
  @@index([updatedAt])
}

model WorkspaceAccessGrant {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String                 @db.Uuid
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  principalType   WorkspacePrincipalType
  /// User or Team id (always a UUID)
  principalId     String                 @db.Uuid
  role            WorkspaceRole
  grantedByUserId String?                @db.Uuid
  grantedBy       User?                  @relation("GrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([workspaceId, principalType, principalId])
  @@index([principalType, principalId])
  @@index([workspaceId, role])
  @@index([createdAt])
  @@index([updatedAt])
}

model WorkspaceActivity {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId String    @db.Uuid
  actor       User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  verb        String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([updatedAt])
}

model SharedEnvironment {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                String    @db.Uuid
  workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                       String
  evaluationServerAddress    String    @default("")
  dataEndpointAddress        String    @default("")
  terminologyEndpointAddress String    @default("")
  contentEndpointAddress     String    @default("")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  headers SharedEnvironmentHttpHeader[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdAt])
  @@index([updatedAt])
}

model SharedEnvironmentHttpHeader {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String             @db.Uuid
  environment   SharedEnvironment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  endpointRole  EndpointRole
  name          String
  value         String             @default("")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([environmentId, endpointRole])
  @@index([createdAt])
  @@index([updatedAt])
}

model UserEnvironment {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String   @db.Uuid
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  evaluationServerAddress    String   @default("")
  dataEndpointAddress        String   @default("")
  terminologyEndpointAddress String   @default("")
  contentEndpointAddress     String   @default("")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  headers UserEnvironmentHttpHeader[]

  @@unique([userId, name])
  @@index([userId])
  @@index([createdAt])
  @@index([updatedAt])
}

model UserEnvironmentHttpHeader {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environmentId String          @db.Uuid
  environment   UserEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  endpointRole  EndpointRole
  name          String
  value         String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([environmentId, endpointRole])
  @@index([createdAt])
  @@index([updatedAt])
}

model WorkspaceResourceReference {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @db.Uuid
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resourceType    String
  resourceId      String
  canonicalUrl    String?
  displayName     String?
  createdByUserId String    @db.Uuid
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, resourceType, resourceId])
  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@index([updatedAt])
}
