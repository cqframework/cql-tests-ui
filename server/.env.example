# CQL Studio Server Environment Variables (Development Defaults)
CQL_STUDIO_SERVER_PORT=3003
CQL_STUDIO_SERVER_NODE_ENV=development
CQL_STUDIO_SERVER_LOG_LEVEL=info

# CORS & Webapp URLs
CQL_STUDIO_SERVER_CORS_ORIGIN=http://localhost:4200
CQL_STUDIO_SERVER_UI_BASE_URL=http://localhost:4200

# Database (PostgreSQL matching docker/docker-compose.development.yml)
CQL_STUDIO_SERVER_DATABASE_URL=postgresql://cql_studio:password@localhost:5432/cql_studio_development

# SSO / OIDC (Authentik matching docker/docker-compose.development.yml)
CQL_STUDIO_SERVER_SSO_ISSUER_URL=http://localhost:9000/application/o/cql-studio/
# Optional: browser-facing IdP origin when SSO_ISSUER_URL is only reachable inside Docker
# (see docker/docker-compose.full.yml). Leave unset for host-run server development.
# CQL_STUDIO_SERVER_SSO_AUTHORIZATION_BASE_URL=http://localhost:9000
CQL_STUDIO_SERVER_SSO_CLIENT_ID=cql-studio-development
CQL_STUDIO_SERVER_SSO_CLIENT_SECRET=cql-studio-development-secret
CQL_STUDIO_SERVER_SSO_REDIRECT_URL=http://localhost:3003/api/auth/callback
CQL_STUDIO_SERVER_SSO_SCOPES=openid profile email
CQL_STUDIO_SERVER_SESSION_SECRET=cql-studio-development-session-secret

# OpenCode gateway and private runner
CQL_STUDIO_SERVER_OPENCODE_ENABLED=true
CQL_STUDIO_SERVER_OPENCODE_RUNNER_URL=http://127.0.0.1:4097
CQL_STUDIO_SERVER_OPENCODE_RUNNER_TOKEN=cql-studio-opencode-development-only
CQL_STUDIO_SERVER_OPENCODE_TOOL_BRIDGE_URL=http://127.0.0.1:3003/api/opencode/tool-bridge
CQL_STUDIO_SERVER_OPENCODE_SESSION_IDLE_MS=3600000
CQL_STUDIO_SERVER_OPENCODE_CLEANUP_INTERVAL_MS=60000
CQL_STUDIO_SERVER_OPENCODE_MAX_SESSIONS_PER_USER=0
CQL_STUDIO_SERVER_OPENCODE_MAX_SESSIONS_GLOBAL=0

# Optional CQL compiler asset overrides. The monorepo UI assets are detected automatically locally.
# CQL_STUDIO_SERVER_CQL_ASSETS_DIRECTORY=/absolute/path/to/ui/public/cql
# CQL_STUDIO_SERVER_CQL_ASSETS_URL=http://localhost:4200/cql
