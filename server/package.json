{
  "name": "@cql-studio/server",
  "version": "2.2.2",
  "description": "CQL Studio backend services and MCP tool orchestration, provided as an Express server using ESM modules",
  "type": "module",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "watch": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "node --test --import tsx tests/ollama-proxy.test.ts tests/vsac-proxy.test.ts tests/hmac-rotation.test.ts tests/ui-return-url.test.ts tests/cors.test.ts tests/opencode-gateway.test.ts tests/opencode-tools.test.ts tests/opencode-url-policy.test.ts",
    "test:opencode:live": "OPENCODE_LIVE_TESTS=1 node --test --import tsx tests/opencode-live.test.ts"
  },
  "author": "Preston Lee",
  "license": "Apache-2.0",
  "dependencies": {
    "@cqframework/cql": "^4.0.0-beta.1",
    "@cql-studio/core": "file:../core",
    "@lhncbc/ucum-lhc": "^7.1.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "node-fetch": "^3.3.2",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "rss-parser": "^3.13.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
