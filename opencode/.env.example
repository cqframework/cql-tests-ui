# CQL Studio OpenCode Runner Environment Variables (host development defaults)
CQL_STUDIO_OPENCODE_NODE_ENV=development
CQL_STUDIO_OPENCODE_LOG_LEVEL=info

# Private runner HTTP API (must match the server gateway token)
CQL_STUDIO_OPENCODE_RUNNER_HOST=127.0.0.1
CQL_STUDIO_OPENCODE_RUNNER_PORT=4097
CQL_STUDIO_OPENCODE_RUNNER_TOKEN=cql-studio-opencode-development-only

# Embedded OpenCode server (loopback only)
CQL_STUDIO_OPENCODE_INTERNAL_PORT=4096

# Session lifecycle
CQL_STUDIO_OPENCODE_SESSION_IDLE_MS=3600000
CQL_STUDIO_OPENCODE_CLEANUP_INTERVAL_MS=60000
CQL_STUDIO_OPENCODE_PROVIDER_STALL_MS=180000

# Host runner: keep localhost provider URLs unchanged.
CQL_STUDIO_OPENCODE_RUNNER_REWRITE_LOCALHOST=false
CQL_STUDIO_OPENCODE_WORKSPACE_ROOT=./workspaces

# Optional overrides. MarkItDown is needed only for PDF/DOCX attachments.
# Install: python3 -m pip install 'markitdown[pdf,docx]==0.1.7'
# CQL_STUDIO_OPENCODE_MARKITDOWN_BIN=/path/to/markitdown
# CQL_STUDIO_OPENCODE_MCP_BRIDGE_BIN=/path/to/mcp-bridge.js
